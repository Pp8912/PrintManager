<Window x:Class="PrintManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Print Manager - Conversión de Color" Height="650" Width="1050" 
        WindowStartupLocation="CenterScreen" Background="#F0F0F0"
        StateChanged="Window_StateChanged">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <!-- Panel Izquierdo: Cola de Documentos -->
        <Border Grid.Column="0" Background="White" Margin="10,10,5,10" CornerRadius="5" Padding="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" Color="#CCCCCC" ShadowDepth="1"/>
            </Border.Effect>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="📋 COLA DE IMPRESIÓN" FontWeight="Bold" FontSize="13" 
                           Margin="0,0,0,10" Foreground="#333"/>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button x:Name="PrintAllButton" Content="🖨 Imprimir Todos" Height="30" 
                            Background="#00AEEF" Foreground="White" BorderThickness="0" 
                            Cursor="Hand" Click="PrintAllButton_Click" Margin="0,2">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="ClearQueueButton" Content="🗑 Limpiar Cola" Height="26" 
                            Background="Transparent" Foreground="#999" BorderBrush="#DDD" 
                            BorderThickness="1" Cursor="Hand" Click="ClearQueueButton_Click" Margin="0,2">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <ListBox x:Name="DocumentList" SelectionChanged="DocumentList_SelectionChanged"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="6,8" Margin="0,1" CornerRadius="4" Background="#F8F8F8"
                                    BorderBrush="#E8E8E8" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" 
                                               FontSize="12" TextTrimming="CharacterEllipsis" Foreground="#333"/>
                                    <TextBlock Text="{Binding DetailText}" FontSize="10" 
                                               Foreground="#888" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Status}" FontSize="10" 
                                               Foreground="#00AEEF" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Centro: Preview con Navegación de Páginas -->
        <DockPanel Grid.Column="1" Margin="5,10">
            <!-- Barra de navegación de páginas -->
            <Border DockPanel.Dock="Bottom" Background="White" CornerRadius="0,0,5,5" Padding="8,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="PrevPageBtn" Content="◀" Width="30" Height="26" 
                            Background="#EEE" BorderThickness="0" Cursor="Hand" Click="PrevPage_Click"
                            FontSize="12">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                        </Button.Resources>
                    </Button>
                    <TextBlock x:Name="PageIndicator" Text="Página 0 / 0" 
                               VerticalAlignment="Center" Margin="12,0" FontSize="12" Foreground="#555"/>
                    <Button x:Name="NextPageBtn" Content="▶" Width="30" Height="26" 
                            Background="#EEE" BorderThickness="0" Cursor="Hand" Click="NextPage_Click"
                            FontSize="12">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

            <Border Background="Gray" CornerRadius="5,5,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="20"/>
                </ScrollViewer>
            </Border>
        </DockPanel>

        <!-- Panel Derecho: Controles -->
        <Border Grid.Column="2" Background="White" Margin="5,10,10,10" CornerRadius="5" Padding="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" Color="#CCCCCC" ShadowDepth="1"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="AJUSTES DE IMPRESIÓN" FontWeight="Bold" FontSize="14" Margin="0,0,0,15" Foreground="#333"/>

                <TextBlock Text="Impresora Física:" FontWeight="SemiBold" Margin="0,5,0,5" FontSize="12"/>
                <ComboBox x:Name="PrinterSelector" Height="28" Padding="5" FontSize="11"/>

                <!-- Selector de Color -->
                <TextBlock Text="Conversión de Color:" FontWeight="SemiBold" Margin="0,15,0,5" FontSize="12"/>
                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Background="#F9F9F9">
                    <StackPanel>
                        <ComboBox x:Name="ColorSelector" Height="30" Padding="5" SelectedIndex="1">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="16" Height="16" CornerRadius="3" 
                                                BorderBrush="#999" BorderThickness="1" Margin="0,0,6,0"
                                                Background="{Binding DisplayBrush}"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Sustituye textos negros por el color seleccionado." 
                                   TextWrapping="Wrap" FontSize="10" Foreground="#666" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Info del Documento -->
                <TextBlock Text="Documento:" FontWeight="SemiBold" Margin="0,15,0,5" FontSize="12"/>
                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Background="#F9F9F9">
                    <StackPanel>
                        <TextBlock x:Name="OrientationText" Text="📐 Orientación: —" FontSize="12" Foreground="#333"/>
                        <TextBlock x:Name="PageSizeText" Text="📄 Tamaño: —" FontSize="12" Foreground="#555" Margin="0,3,0,0"/>
                        <TextBlock x:Name="PageCountText" Text="📑 Páginas: —" FontSize="12" Foreground="#555" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <Button x:Name="OpenButton" Content="📂 Abrir PDF..." Height="28" Margin="0,12,0,0" 
                        Background="#EEE" Foreground="#333" BorderBrush="#CCC" BorderThickness="1" 
                        Cursor="Hand" Click="OpenButton_Click" FontSize="11">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                    </Button.Resources>
                </Button>

                <Separator Margin="0,15"/>

                <TextBlock x:Name="StatusText" Text="Vigilando cola de impresión..." 
                           Foreground="Gray" TextAlignment="Center" Margin="0,8" FontSize="11" TextWrapping="Wrap"/>

                <Button x:Name="PrintButton" Content="🖨 IMPRIMIR SELECCIONADO" Height="42" FontSize="13" 
                        FontWeight="Bold" Background="#00AEEF" Foreground="White" Margin="0,8,0,0" 
                        BorderThickness="0" Cursor="Hand" Click="PrintButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="CancelButton" Content="Minimizar" Height="30" Margin="0,8,0,0" 
                        Background="Transparent" BorderBrush="#999" BorderThickness="1" 
                        Foreground="#666" Cursor="Hand" Click="CancelButton_Click" FontSize="11">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
